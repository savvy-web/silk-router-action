**/.DS_Store
**/node_modules
**/*.tsbuildinfo

# Generated TypeScript declaration files for config files
*.config.d.ts
# NOTE: dist/ is NOT ignored - compiled GitHub Actions must be committed
# The dist/ folder contains the compiled action code that GitHub Actions will execute
# .github/actions/local/ is generated during build and also tracked for fixture testing
**/build
**/.rslib
**/.artifacts
**/.turbo
**/.coverage
**/.vitest
**/.cache
coverage/
**/*.asc
pnpm-publish-summary.json
pnpm-release.json
.changeset/status.json

# Environment files (keep .example files committed)
.env
.env.local
.env.development
.env.production
.env.test
.env.workflow
.env.workflow-cli
!.env.example
!.env.*.example

# Claude AI files
.claude/settings.local.json
.claude/plans/
.claude/dogfood/
docs/superpowers/
.claude/plugins-debug.log
.playwright-mcp
